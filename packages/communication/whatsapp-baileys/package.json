{
  "name": "@pikku/addon-whatsapp-baileys",
  "version": "0.1.3",
  "type": "module",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": [
      "./dist/.pikku/*/index.js",
      "./dist/.pikku/*"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./.pikku/*": "./dist/.pikku/addon/*",
    "./.pikku/pikku-metadata.gen.json": "./dist/.pikku/addon/pikku-metadata.gen.json",
    "./.pikku/rpc/pikku-rpc-wirings-map.internal.gen.js": {
      "types": "./dist/.pikku/addon/rpc/pikku-rpc-wirings-map.internal.gen.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pikku all",
    "build": "tsc && cp -r .pikku types dist/",
    "pikku": "pikku all",
    "ncu": "npx npm-check-updates",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.86",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "qrcode-terminal": ">=0.12",
    "zod": "^4"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.107",
    "@pikku/core": "^0.12.86",
    "@types/qrcode-terminal": "^0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4",
    "typescript": "^5.7.2",
    "zod": "^4"
  }
}
