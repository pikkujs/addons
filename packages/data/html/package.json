{
  "name": "@pikku/addon-html",
  "version": "0.1.4",
  "type": "module",
  "imports": {
    "#pikku/*.gen.js": "./.pikku/*.gen.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./.pikku/*": "./dist/.pikku/*",
    "./.pikku/pikku-metadata.gen.json": "./dist/.pikku/pikku-metadata.gen.json",
    "./.pikku/rpc/pikku-rpc-wirings-map.internal.gen.js": {
      "types": "./dist/.pikku/rpc/pikku-rpc-wirings-map.internal.gen.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pikku all",
    "build": "tsc && cp -r .pikku types dist/",
    "pikku": "pikku all",
    "test": "cd test && yarn test"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.86",
    "zod": "^4"
  },
  "dependencies": {
    "html-to-text": "^9",
    "node-html-markdown": "^1"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.107",
    "@pikku/core": "^0.12.86",
    "typescript": "^5.7.2",
    "zod": "^4"
  }
}
