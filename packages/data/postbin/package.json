{
  "name": "@pikku/addon-postbin",
  "version": "0.0.3",
  "type": "module",
  "imports": {
    "#pikku": "./.pikku/pikku-types.gen.ts",
    "#pikku/*": "./.pikku/*"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./.pikku/*": "./dist/.pikku/*",
    "./.pikku/pikku-metadata.gen.json": "./dist/.pikku/pikku-metadata.gen.json",
    "./.pikku/rpc/pikku-rpc-wirings-map.internal.gen.js": {
      "types": "./dist/.pikku/rpc/pikku-rpc-wirings-map.internal.gen.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "yarn build",
    "prebuild": "pikku all",
    "build": "tsc && cp -r .pikku types dist/",
    "pikku": "pikku all"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.74",
    "zod": "^4"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.96",
    "@pikku/core": "^0.12.74",
    "typescript": "^5.7.2",
    "zod": "^4"
  }
}
