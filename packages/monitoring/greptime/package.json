{
  "name": "@pikku/addon-greptime",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/addons.git",
    "directory": "packages/monitoring/greptime"
  },
  "description": "GreptimeDB telemetry store for Pikku Studio: an addon that provides the TelemetryStore service through a contributor",
  "type": "module",
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": "./dist/.pikku/*/index.js"
  },
  "exports": {
    ".": "./dist/.pikku/addon/pikku-bootstrap.gen.js",
    "./store": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src/*.js": "./dist/src/*.js",
    "./.pikku/contributors/*": "./.pikku/addon/contributors/*",
    "./.pikku/*": "./dist/.pikku/addon/*",
    "./.pikku/pikku-metadata.gen.json": "./dist/.pikku/addon/pikku-metadata.gen.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    ".pikku/addon/contributors",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "prepublishOnly": "bun run build",
    "build": "bun run clean && pikku all && tsc && rsync -a --include='*/' --include='*.json' --exclude='*' .pikku/addon/ dist/.pikku/addon/ && (mkdir -p dist/types && cp types/*.d.ts dist/types/)",
    "pikku": "pikku all",
    "tsc": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.156"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.210",
    "@pikku/core": "^0.12.156",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^24"
  },
  "license": "MIT"
}
