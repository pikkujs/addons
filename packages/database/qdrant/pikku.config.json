{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "tsconfig": "./tsconfig.json",
  "srcDirectories": [
    "src",
    "types"
  ],
  "outDir": "./.pikku",
  "addon": {
    "displayName": "Qdrant",
    "description": "Vector search over a Qdrant collection — embed a query and retrieve the nearest matches",
    "categories": [
      "Search",
      "Write"
    ]
  },
  "forceRequiredServices": [
    "qdrant",
    "aiEmbedding"
  ]
}
