{
  "name": "@pikku/addon-supabase",
  "version": "0.2.0",
  "type": "module",
  "imports": {
    "#pikku": "./dist/.pikku/pikku-types.gen.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./.pikku/*": "./dist/.pikku/*",
    "./.pikku/pikku-metadata.gen.json": "./dist/.pikku/pikku-metadata.gen.json",
    "./.pikku/rpc/pikku-rpc-wirings-map.internal.gen.js": {
      "types": "./dist/.pikku/rpc/pikku-rpc-wirings-map.internal.gen.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pikku all",
    "build": "tsc && cp -r .pikku types dist/",
    "pikku": "pikku all",
    "ncu": "npx npm-check-updates",
    "test": "cd test && yarn test"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.83",
    "zod": "^4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.103",
    "@pikku/core": "^0.12.83",
    "typescript": "^5.7.2",
    "zod": "^4"
  }
}
