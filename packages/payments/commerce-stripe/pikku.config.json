{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "tsconfig": "./tsconfig.json",
  "srcDirectories": [
    "src",
    "types"
  ],
  "outDir": "./.pikku",
  "addon": {
    "displayName": "Stripe Commerce",
    "description": "A ready-made Stripe storefront: catalogue, cart, checkout, orders, fulfilment and refunds, shipping its own tables. Talks the Stripe HTTP API directly, with no SDK dependency.",
    "categories": [
      "Catalogue",
      "Cart",
      "Checkout",
      "Shipping",
      "Orders",
      "Customers",
      "Webhooks"
    ],
    "icon": "./commerce-stripe.svg"
  }
}
