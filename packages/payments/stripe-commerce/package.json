{
  "name": "@pikku/addon-stripe-commerce",
  "version": "0.1.0",
  "description": "A ready-made Stripe storefront: catalogue, cart, checkout, orders, fulfilment, refunds and subscriptions, shipping its own tables. Talks to the Stripe HTTP API directly, with no SDK dependency.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pikku",
    "pikku-addon",
    "stripe",
    "ecommerce",
    "payments",
    "checkout",
    "subscriptions"
  ],
  "homepage": "https://github.com/pikkujs/addons/tree/main/packages/payments/stripe-commerce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikkujs/addons.git",
    "directory": "packages/payments/stripe-commerce"
  },
  "imports": {
    "#pikku/*.js": "./dist/.pikku/*.js",
    "#pikku/*": [
      "./dist/.pikku/*/index.js",
      "./dist/.pikku/*"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./types": {
      "types": "./dist/types/application-types.d.ts"
    },
    "./.pikku/*": "./dist/.pikku/addon/*",
    "./.pikku/pikku-metadata.gen.json": "./dist/.pikku/addon/pikku-metadata.gen.json",
    "./.pikku/db/pikku-db-meta.gen.json": "./dist/.pikku/addon/db/pikku-db-meta.gen.json",
    "./.pikku/rpc/pikku-rpc-wirings-map.internal.gen.js": {
      "types": "./dist/.pikku/addon/rpc/pikku-rpc-wirings-map.internal.gen.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pikku all && pikku db export",
    "build": "tsc && cp -r .pikku types db dist/",
    "pikku": "pikku all && pikku db export",
    "ncu": "npx npm-check-updates",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "@pikku/core": "^0.12.89",
    "kysely": "^0.29.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@pikku/cli": "^0.12.111",
    "@pikku/core": "^0.12.89",
    "kysely": "^0.29.5",
    "typescript": "^5.7.2",
    "zod": "^4"
  }
}
