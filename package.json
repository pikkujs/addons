{
  "name": "pikku-addons",
  "private": true,
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "pikku": "scripts/foreach-addon.sh --all -- bun run pikku",
    "build": "scripts/foreach-addon.sh --all -- bun run build",
    "tsc": "bun run --filter '*' tsc",
    "test": "bun run --filter '*' test",
    "ncu": "bun run --filter '*' ncu",
    "clean": "bun run --filter '*' clean",
    "update-pikku": "node scripts/update-pikku-versions.mjs && bun install",
    "changeset": "npx changeset",
    "release": "bun run build && npx changeset publish"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@better-auth/core": "^1.7.2",
    "@changesets/cli": "^3.0.3",
    "better-auth": "^1.6.0",
    "node-gyp": "^12.2.0"
  },
  "trustedDependencies": [
    "sweph"
  ]
}
